# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (cloud) connection string
# Get one free at https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/notesapp?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS - your frontend URL in production
CLIENT_ORIGIN=http://localhost:3000
